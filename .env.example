# LocalMeetingRecorder settings. Copy to .env for local overrides. No secrets belong here.
# All variables are optional; defaults are defined in src/local_meeting_recorder/config.py

# Root for runtime data (recordings, logs, database). Default: ~/Library/Application Support/LocalMeetingRecorder
#LMR_DATA_DIR=

# Path to the native capture helper. Default: auto-detected (native/macos/build/lmr-capture-helper in dev)
#LMR_HELPER_PATH=

# Minimum free disk space required to start a recording, in MB
#LMR_MIN_FREE_DISK_MB=1024

# Video frame rate and encoder bitrate used by the helper
#LMR_VIDEO_FPS=30
#LMR_VIDEO_BITRATE_KBPS=6000

# Capture the microphone (true/false)
#LMR_CAPTURE_MICROPHONE=true

# Log level: DEBUG, INFO, WARNING, ERROR
#LMR_LOG_LEVEL=INFO

# Local LLM endpoint for summaries (Phase 5). Never a remote service by default.
#LMR_OLLAMA_BASE_URL=http://127.0.0.1:11434
#LMR_OLLAMA_MODEL=

# Transcription model name for faster-whisper (Phase 4); downloads only after confirmation
#LMR_WHISPER_MODEL=small
